{
  // Worker API FraternApp — reçoit les inscriptions et déclenche GitHub Actions
  // Déployé sur : velum-onboarding.rezofabrik.workers.dev  (+  fraternapp.com/api/*)
  //
  // Secrets à configurer UNE SEULE FOIS via terminal :
  //   wrangler secret put GITHUB_TOKEN   ← Personal Access Token GitHub (Actions:write)
  //   wrangler secret put GITHUB_REPO    ← ex: rezofabrik-hub/comte-guifr-
  //
  // Puis déployer :
  //   wrangler deploy --config velum-onboarding/wrangler.jsonc
  "name": "velum-onboarding",
  "main": "api-worker.js",
  "compatibility_date": "2026-07-20",
  "kv_namespaces": [
    { "binding": "LODGES", "id": "bf2daa2ce915450599a4de04d554e99d" }
  ],
  "routes": [{ "pattern": "fraternapp.com/api/*", "zone_name": "fraternapp.com" }]
}
