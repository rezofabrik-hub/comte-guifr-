rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each lodge stores its files under its own slug path
    match /artifacts/{appId}/{allPaths=**} {
      // Read: any signed-in user whose email belongs to this lodge
      allow read: if request.auth != null
        && request.auth.token.email.matches('.*@' + appId + '\\.velum\\.fr');
      // Write: same lodge, max 15 MB, only VM/Architecte/Tresorier can write
      allow write: if request.auth != null
        && request.auth.token.email.matches('.*@' + appId + '\\.velum\\.fr')
        && request.resource.size < 15 * 1024 * 1024;
    }
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
