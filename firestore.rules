// Règles Firestore – Loge Comte Guifré n°51
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function email() {
      return request.auth.token.email;
    }
    function isCompagnon() {
      return email() in ['compagnon@cg51-virtuel.fr','maitre@cg51-virtuel.fr','architecte@cg51-virtuel.fr'];
    }
    function isMaitre() {
      return email() in ['maitre@cg51-virtuel.fr','architecte@cg51-virtuel.fr'];
    }
    function isArchitecte() {
      return email() == 'architecte@cg51-virtuel.fr';
    }
    function isTresorier() {
      return isSignedIn() && email() in ['tresorier@cg51-virtuel.fr','vm@cg51-virtuel.fr','architecte@cg51-virtuel.fr'];
    }
    function isGradeMember() {
      return isSignedIn() && email() in ['apprenti@cg51-virtuel.fr','compagnon@cg51-virtuel.fr','maitre@cg51-virtuel.fr','tresorier@cg51-virtuel.fr','vm@cg51-virtuel.fr','architecte@cg51-virtuel.fr'];
    }

    // Données publiques de la loge : lecture libre pour tout membre authentifié,
    // écriture réservée selon le grade. Le filtrage par grade est fait côté client.
    match /artifacts/{appId}/public/data/members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaitre();
    }

    match /artifacts/{appId}/public/data/agenda/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaitre();
    }

    match /artifacts/{appId}/public/data/planches/{docId} {
      allow read: if isSignedIn();
      allow create: if isCompagnon();
      allow update, delete: if isMaitre();
    }

    match /artifacts/{appId}/public/data/bibliotheque/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isArchitecte();
    }

    match /artifacts/{appId}/public/data/liens/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isArchitecte();
    }

    match /artifacts/{appId}/public/data/settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isArchitecte();
    }

    // Trésorerie : lecture réservée membres de grade, écriture trésorier uniquement
    match /artifacts/{appId}/public/data/tresor_transactions/{docId} {
      allow read, write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_cotisations/{docId} {
      allow read, write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_membres/{docId} {
      allow read: if isGradeMember();
      allow write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_agapes/{docId} {
      allow read: if isGradeMember();
      allow write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_planches/{docId} {
      allow read: if isGradeMember();
      allow write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_presences/{docId} {
      allow read: if isGradeMember();
      allow write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_settings/{docId} {
      allow read: if isGradeMember();
      allow write: if isTresorier();
    }
    match /artifacts/{appId}/public/data/tresor_charges/{docId} {
      allow read, write: if isTresorier();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
