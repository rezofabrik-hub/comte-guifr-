// Règles Firestore — Velum Loge · Multi-tenant v3
// Chaque loge est isolée par son appId (slug) dans le chemin Firestore.
// Les emails suivent le format : grade@{slug}.velum.fr
// v2026-08-27b — fix: remplace startsWith/endsWith (invalides) par split('@') et matches()
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // Extrait le slug de la loge depuis l'email
    // Formats supportés : vm@cg51.velum.fr → cg51 | maitre@cg51-virtuel.fr → site-cg51
    function emailLodgeId() {
      let domain = userEmail().split('@')[1];
      // Domaine legacy lcg51.fr → site-cg51
      return domain == 'cg51-virtuel.fr' ? 'site-cg51' : domain.split('.velum.fr')[0];
    }

    // Vérifie que l'utilisateur appartient bien à la loge demandée
    function ownLodge(appId) {
      return emailLodgeId() == appId;
    }

    // startsWith/endsWith ne sont pas supportés en Firestore rules → utiliser split('@') et matches()
    function hasRole(role) {
      let parts = userEmail().split('@');
      let domain = parts[1];
      return parts[0] == role &&
             (domain == 'cg51-virtuel.fr' || domain.matches('.*\\.velum\\.fr'));
    }

    function isVMouArchitecte() {
      return isSignedIn() && (hasRole('vm') || hasRole('architecte'));
    }

    function isTresorier() {
      return isSignedIn() && (hasRole('tresorier') || hasRole('vm') || hasRole('architecte'));
    }

    function isGradeMember() {
      let domain = userEmail().split('@')[1];
      return isSignedIn() && (domain == 'cg51-virtuel.fr' || domain.matches('.*\\.velum\\.fr'));
    }

    // ── Membres ──────────────────────────────────────────────────────────────
    match /artifacts/{appId}/public/data/members/{memberId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow create, update, delete: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Agenda / Ordre des Travaux ────────────────────────────────────────────
    match /artifacts/{appId}/public/data/agenda/{itemId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow create, update, delete: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Planches ─────────────────────────────────────────────────────────────
    match /artifacts/{appId}/public/data/planches/{docId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow create, update, delete: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Bibliothèque ──────────────────────────────────────────────────────────
    match /artifacts/{appId}/public/data/bibliotheque/{docId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow create, update, delete: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Liens utiles ──────────────────────────────────────────────────────────
    match /artifacts/{appId}/public/data/liens/{docId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow create, update, delete: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Paramètres (identité, logo, mots de passe, welcome…) ─────────────────
    match /artifacts/{appId}/public/data/settings/{docId} {
      allow read: if isSignedIn() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId);
    }

    // ── Trésorerie (accès Trésorier + VM + Architecte) ───────────────────────
    match /artifacts/{appId}/public/data/tresor_transactions/{docId} {
      allow read, write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_cotisations/{docId} {
      allow read, write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_membres/{docId} {
      allow read: if isGradeMember() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_agapes/{docId} {
      allow read: if isGradeMember() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_planches/{docId} {
      allow read: if isGradeMember() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_presences/{docId} {
      allow read: if isGradeMember() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_settings/{docId} {
      allow read: if isGradeMember() && ownLodge(appId);
      allow write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }
    match /artifacts/{appId}/public/data/tresor_charges/{docId} {
      allow read, write: if isVMouArchitecte() && ownLodge(appId) || isTresorier() && ownLodge(appId);
    }

    // ── Fallback : tout refuser ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
